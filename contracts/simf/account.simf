use std::lib::utxo::asserts::asset_id::assert_explicit_input_asset_id;

fn network_asset_auth(storm_eye_input_index: u32) {
    assert_explicit_input_asset_id(storm_eye_input_index, param::STORM_EYE_ASSET_ID);
}

fn main() {
    let _: Pubkey = param::ACCOUNT_OWNER_PUBKEY;

    let storm_eye_input_index: u32 = witness::STORM_EYE_INPUT_INDEX;

    network_asset_auth(storm_eye_input_index);
}
