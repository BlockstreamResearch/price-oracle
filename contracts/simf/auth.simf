use std::lib::asserts::{assert_eq_1, assert_eq_32, assert_eq_64, assert_eq_256};
use std::lib::u8::math::gt_8;
use std::lib::u8::convert::u8_to_u32;
use std::lib::u32::math::{safe_add_32, gt_32};
use std::lib::u64::math::safe_add_64;

use crate::helper::{
    get_explicit_current_amount,
    get_explicit_output_amount,
    get_explicit_input_amount,
    get_output_script_hash,
    get_input_script_hash,
    get_current_asset,
    assert_output_preserves_utxo
};
use crate::storage::{get_script_hash_for_storage};
use crate::auth_helpers::network::{StormTreeBloom, assert_network_authorization};

/// Taproot storage: Storm Tree root, rescue block number.
type Storage = (u256, Height);

/// 1. output_index
type InclusionWit = u32;
/// 2. new_merkle_root, output_index
type RootUpdateWit = (u256, u32);
/// 3. new_rescue_block_number, output_index
type RescueBlockUpdateWit = (Height, u32);
/// 4. split_utxos_count
type SplitWit = u8;
/// 5. utxos_to_merge
type MergeWit = u8;

type UpdateKind = Either<RootUpdateWit, RescueBlockUpdateWit>;
type ReshapeKind = Either<SplitWit, MergeWit>;
type AuthKind = Either<InclusionWit, Either<UpdateKind, ReshapeKind>>;

/// 1-5. Every network-authorised path carries the same storage and bloom.
type AuthorizedWit = (Storage, StormTreeBloom, AuthKind);
/// 6. The rescue path is the only one with no signature and no proof.
type RescueWit = (Storage, u32);

fn script_hash_for(storage: Storage) -> u256 {
    let (merkle_root, rescue_block_number): Storage = storage;
    get_script_hash_for_storage(merkle_root, rescue_block_number)
}

fn assert_storage_with_current(storage: Storage) {
    assert_eq_256(jet::current_script_hash(), script_hash_for(storage));
}

fn assert_storage_with_output(storage: Storage, output_index: u32) {
    assert_eq_256(get_output_script_hash(output_index), script_hash_for(storage));
}

fn assert_output_script_hash_matches_current(output_index: u32) {
    assert_eq_256(get_output_script_hash(output_index), jet::current_script_hash());
}

/// 1. Authorized inclusion in a transaction without storage updating.
fn auth_without_storage_updating(storage: Storage, output_index: u32) {
    assert_storage_with_current(storage);
    assert_output_script_hash_matches_current(output_index);
    assert_output_preserves_utxo(output_index);
}

/// 2. Authorized inclusion in a transaction with an update
/// to the Storm Tree root using the network signature.
fn auth_with_update_storm_tree_root(storage: Storage, new_merkle_root: u256, output_index: u32) {
    let (_, rescue_block_number): Storage = storage;
    let new_storage: Storage = (new_merkle_root, rescue_block_number);

    assert_storage_with_current(storage);
    assert_storage_with_output(new_storage, output_index);
    assert_output_preserves_utxo(output_index);
}

/// 3. Authorized inclusion in a transaction with an update
/// to the rescue block number using a network signature.
fn auth_with_update_rescue_block(
    storage: Storage,
    new_rescue_block_number: Height,
    output_index: u32
) {
    // Minutes in 3 years.
    let (merkle_root, current_rescue_block_number): Storage = storage;
    let expected_new_rescue_block_number: Height = safe_add_32(
        current_rescue_block_number,
        1_576_800
    );
    assert_eq_32(new_rescue_block_number, expected_new_rescue_block_number);

    let new_storage: Storage = (merkle_root, new_rescue_block_number);

    assert_storage_with_current(storage);
    assert_storage_with_output(new_storage, output_index);
    assert_output_preserves_utxo(output_index);
}

/// Loop-invariant data for the split: how many outputs to visit, and what each must look like.
type StepUtxosCtx = (u8, u256, u256);

/// One split output: check its shape, add its amount. `Left` ends the loop.
fn step_collect_total_amount(
    total_outputs_amount: u64,
    ctx: StepUtxosCtx,
    counter: u8
) -> Either<u64, u64> {
    let (split_utxos_count, expected_script_hash, current_asset): StepUtxosCtx = ctx;

    // Past the last split output: stop, carrying the total.
    match jet::lt_8(counter, split_utxos_count) {
        true => {
            let output_index: u32 = u8_to_u32(counter);
            let (
                output_asset,
                output_amount
            ): (u256, u64) = get_explicit_output_amount(output_index);

            assert_eq_256(get_output_script_hash(output_index), expected_script_hash);
            assert_eq_256(output_asset, current_asset);

            Right(safe_add_64(total_outputs_amount, output_amount))
        },
        false => Left(total_outputs_amount),
    }
}

/// 4. Authorized splitting of a Storm Eye UTXO into
/// multiple UTXOs with the same Storm Tree root.
fn auth_split_storm_eye_utxo_into_multiple_utxos(storage: Storage, split_utxos_count: u8) {
    assert_eq_32(jet::current_index(), 0);
    assert_storage_with_current(storage);

    assert!(gt_8(split_utxos_count, 1));
    assert!(jet::lt_8(split_utxos_count, param::MAX_SPLIT_UTXOS_COUNT));

    let (current_asset, current_amount): (u256, u64) = get_explicit_current_amount();
    let ctx: StepUtxosCtx = (split_utxos_count, jet::current_script_hash(), current_asset);

    let out: Either<u64, u64> = for_while::<step_collect_total_amount>(0, ctx);
    assert_eq_64(current_amount, unwrap_left::<u64>(out));
}

/// One merged input: check its shape, add its amount. `Left` ends the loop.
fn step_collect_input_total_amount(
    total_inputs_amount: u64,
    ctx: StepUtxosCtx,
    counter: u8
) -> Either<u64, u64> {
    let (utxos_to_merge, expected_script_hash, current_asset): StepUtxosCtx = ctx;

    match jet::lt_8(counter, utxos_to_merge) {
        true => {
            let input_index: u32 = u8_to_u32(counter);
            let (input_asset, input_amount): (u256, u64) = get_explicit_input_amount(input_index);

            assert_eq_256(get_input_script_hash(input_index), expected_script_hash);
            assert_eq_256(input_asset, current_asset);

            Right(safe_add_64(total_inputs_amount, input_amount))
        },
        false => Left(total_inputs_amount),
    }
}

/// 5. Authorized merging of multiple Storm Eyes into
/// a single Storm Eye UTXO with the same Storm Tree root.
fn auth_merge_multiple_storm_eyes_into_single_utxo(storage: Storage, utxos_to_merge: u8) {
    assert_storage_with_current(storage);
    assert_output_script_hash_matches_current(0);

    assert!(gt_8(utxos_to_merge, 1));
    assert!(jet::lt_8(utxos_to_merge, param::MAX_MERGE_UTXOS_COUNT));
    assert!(jet::lt_32(jet::current_index(), u8_to_u32(utxos_to_merge)));

    let current_asset: u256 = get_current_asset();
    let ctx: StepUtxosCtx = (utxos_to_merge, jet::current_script_hash(), current_asset);

    let total_inputs_amount: u64 = unwrap_left::<u64>(
        for_while::<step_collect_input_total_amount>(0, ctx)
    );

    let (output_asset, output_amount): (u256, u64) = get_explicit_output_amount(0);
    assert_eq_64(output_amount, total_inputs_amount);
    assert_eq_256(output_asset, current_asset);
}

/// 6. Inclusion in a transaction upon reaching the rescue block number,
/// with the option to spend to output with the RESCUE_OUTPUT_SCRIPT_HASH script hash
fn rescue_after_block_number(storage: Storage, output_index: u32) {
    let (_, rescue_block_number): Storage = storage;

    assert_storage_with_current(storage);
    jet::check_lock_height(rescue_block_number);

    assert_eq_256(get_output_script_hash(output_index), param::RESCUE_OUTPUT_SCRIPT_HASH);
    assert_output_preserves_utxo(output_index);
}

/// Paths 2-3: the storage-rotating arms.
fn dispatch_update(storage: Storage, update: UpdateKind) {
    match update {
        Left(wit: RootUpdateWit) => {
            let (new_merkle_root, output_index): RootUpdateWit = wit;
            auth_with_update_storm_tree_root(storage, new_merkle_root, output_index);
        },
        Right(wit: RescueBlockUpdateWit) => {
            let (new_rescue_block_number, output_index): RescueBlockUpdateWit = wit;
            auth_with_update_rescue_block(storage, new_rescue_block_number, output_index);
        },
    }
}

/// Paths 4-5: the arms that change how many UTXOs the asset sits in.
fn dispatch_reshape(storage: Storage, reshape: ReshapeKind) {
    match reshape {
        Left(split_utxos_count: SplitWit) => {
            auth_split_storm_eye_utxo_into_multiple_utxos(storage, split_utxos_count);
        },
        Right(utxos_to_merge: MergeWit) => {
            auth_merge_multiple_storm_eyes_into_single_utxo(storage, utxos_to_merge);
        },
    }
}

/// Paths 1-5, every one of them network-authorised.
fn dispatch_authorized(authorized: AuthorizedWit) {
    let (storage, bloom, kind): AuthorizedWit = authorized;
    let (merkle_root, _): Storage = storage;

    // The proof and the signature are checked once, before the paths diverge.
    assert_network_authorization(merkle_root, bloom);

    match kind {
        Left(output_index: InclusionWit) => {
            auth_without_storage_updating(storage, output_index);
        },
        Right(update_or_reshape: Either<UpdateKind, ReshapeKind>) => match update_or_reshape {
            Left(update: UpdateKind) => dispatch_update(storage, update),
            Right(reshape: ReshapeKind) => dispatch_reshape(storage, reshape),
        },
    }
}

fn main() {
    match witness::PATH {
        Left(authorized: AuthorizedWit) => dispatch_authorized(authorized),
        Right(rescue: RescueWit) => {
            let (storage, output_index): RescueWit = rescue;
            rescue_after_block_number(storage, output_index);
        },
    }
}
