use std::lib::asserts::assert_eq_256;

/// One monotree node's serialization, minus the 32-byte child hash,
/// packed off-chain into fixed-width slots of 32, 32, 16, 16, 8, 4, 2, 1 bytes.
///
/// The slots are hashed in this order, so the selected ones spell the cut out
/// contiguously. Capacity is 111 bytes and every length is `32a + 16b + (0..15)`, which
/// covers every cut monotree can produce: 6..37 for a Soft node, 43..105 for a Hard one.
type CutSlots = (u256, u256, u128, u128, u64, u32, u16, u8);
/// Which slots belong to this cut. The chosen set spells its length in the sizes above.
type CutMask = (bool, bool, bool, bool, bool, bool, bool, bool);
type Cut = (CutSlots, CutMask);

/// One level of the fold: which child we descended into, and that node's cut.
/// `Left` is an unused step, so a proof shorter than the fixed depth costs one bit per
/// padding slot instead of a whole cut.
type StormTreeProofStep = Either<(), (bool, Cut)>;

// TODO: Make StormTreeProofStep arbitrary (depth 21 for example)
/// The aggregate signature, the signing
/// combination's MuSig2 key, and its inclusion proof under the stored root.
pub type StormTreeBloom = (
    Signature,                // MuSig2 signature
    Pubkey,                   // Signing storm tree branch (the MuSig2 aggregate key)
    [StormTreeProofStep; 3],  // Signing storm tree branch merkle proof
);

// Network authorization

/// The message the network signs for any Storm Eye operation.
///
/// Network Spec Part III §3 instead calls for a BIP-340 tagged hash of this value under
/// `OracleNetworkV1/StormEye`. That variant is one extra hash here:
///
///     sha256(sha256(tag) || sha256(tag) || jet::sig_all_hash())
///     with sha256("OracleNetworkV1/StormEye")
///       = 0xc167b450e88f500269275c422460371cb2a57a02c22d39bcede8bd016aea2cd8
///
/// but the smplx signer only ever signs the untagged `sighash_all`, so a tagged
/// signature has to come from the network's own signing code; no test can produce one.
fn get_signing_message() -> u256 {
    jet::sig_all_hash()
}

// NOTE: The Storm Tree stores each branch under its own
// key with itself as the value, so a branch's leaf is the branch, with no hash and no
// tag in between.

// TODO: Add `OracleNetworkV1/StormTreeLeaf` tag and `get_storm_tree_leaf` function,
// once it will be implemented in storm-tree.

/// Adds one packed cut to the hash context, slot by slot.
fn add_cut(cut: Cut, ctx: Ctx8) -> Ctx8 {
    let (slots, mask): Cut = cut;
    let (s32a, s32b, s16a, s16b, s8, s4, s2, s1): CutSlots = slots;
    let (m32a, m32b, m16a, m16b, m8, m4, m2, m1): CutMask = mask;

    let ctx: Ctx8 = match m32a { true => jet::sha_256_ctx_8_add_32(ctx, s32a), false => ctx, };
    let ctx: Ctx8 = match m32b { true => jet::sha_256_ctx_8_add_32(ctx, s32b), false => ctx, };
    let ctx: Ctx8 = match m16a { true => jet::sha_256_ctx_8_add_16(ctx, s16a), false => ctx, };
    let ctx: Ctx8 = match m16b { true => jet::sha_256_ctx_8_add_16(ctx, s16b), false => ctx, };
    let ctx: Ctx8 = match m8   { true => jet::sha_256_ctx_8_add_8(ctx, s8),    false => ctx, };
    let ctx: Ctx8 = match m4   { true => jet::sha_256_ctx_8_add_4(ctx, s4),    false => ctx, };
    let ctx: Ctx8 = match m2   { true => jet::sha_256_ctx_8_add_2(ctx, s2),    false => ctx, };

    match m1 { true => jet::sha_256_ctx_8_add_1(ctx, s1), false => ctx, }
}

fn storm_tree_fold_step(step: StormTreeProofStep, node: u256) -> u256 {
    match step {
        Left(_: ()) => node,
        Right(level: (bool, Cut)) => {
            let (is_right, cut): (bool, Cut) = level;
            let ctx: Ctx8 = jet::sha_256_ctx_8_init();

            let ctx: Ctx8 = match is_right {
                true => {
                    let ctx: Ctx8 = add_cut(cut, ctx);
                    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, node);
                    jet::sha_256_ctx_8_add_1(ctx, 0x01)
                },
                false => {
                    let ctx: Ctx8 = jet::sha_256_ctx_8_add_32(ctx, node);
                    add_cut(cut, ctx)
                }
            };

            jet::sha_256_ctx_8_finalize(ctx)
        }
    }
}

/// Proves the signing combination is in the Storm Tree committed
/// to by storage, and that it signed this transaction.
pub fn assert_network_authorization(merkle_root: u256, bloom: StormTreeBloom) {
    let (signature, branch, merkle_proof): StormTreeBloom = bloom;

    // The fold starts from the branch itself: it is its own leaf, untagged. See the note above `add_cut`.
    let computed_root: u256 = array_fold::<storm_tree_fold_step, 3>(
        merkle_proof,
        branch
    );
    assert_eq_256(computed_root, merkle_root);

    jet::bip_0340_verify((branch, get_signing_message()), signature);
}
