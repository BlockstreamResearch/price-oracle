use std::lib::asserts::{assert_eq_64, assert_eq_256};

// TODO: Maybe it would be better to separate asset/amount getters into separate file.
// Add them into std library for future.

/// Return explicit input asset and amount
pub fn get_explicit_input_amount(output_index: u32) -> (u256, u64) {
    let (output_asset, output_amount): (Asset1, Amount1) = unwrap(jet::input_amount(output_index));
    let output_asset: u256 = unwrap_right::<Point>(output_asset);
    let output_amount: u64 = unwrap_right::<Point>(output_amount);

    (output_asset, output_amount)
}

/// Return explicit output asset and amount
pub fn get_explicit_output_amount(output_index: u32) -> (u256, u64) {
    let (output_asset, output_amount): (Asset1, Amount1) = unwrap(jet::output_amount(output_index));
    let output_asset: u256 = unwrap_right::<Point>(output_asset);
    let output_amount: u64 = unwrap_right::<Point>(output_amount);

    (output_asset, output_amount)
}

/// Return explicit current asset and amount
pub fn get_explicit_current_amount() -> (u256, u64) {
    let (output_asset, output_amount): (Asset1, Amount1) = jet::current_amount();
    let output_asset: u256 = unwrap_right::<Point>(output_asset);
    let output_amount: u64 = unwrap_right::<Point>(output_amount);

    (output_asset, output_amount)
}

/// The Storm Eye UTXO must be spent in its entirety: same asset, same amount.
pub fn assert_output_preserves_utxo(output_index: u32) {
    let (output_asset, output_amount): (u256, u64) = get_explicit_output_amount(output_index);
    let (current_asset, current_amount): (u256, u64) = get_explicit_current_amount();

    assert_eq_256(output_asset, current_asset);
    assert_eq_64(output_amount, current_amount);
}

pub fn get_output_asset(output_index: u32) -> u256 {
    unwrap_right::<Point>(unwrap(jet::output_asset(output_index)))
}

pub fn get_current_asset() -> u256 {
    unwrap_right::<Point>(jet::current_asset())
}

pub fn get_input_script_hash(input_index: u32) -> u256 {
    unwrap(jet::input_script_hash(input_index))
}

pub fn get_output_script_hash(output_index: u32) -> u256 {
    unwrap(jet::output_script_hash(output_index))
}
