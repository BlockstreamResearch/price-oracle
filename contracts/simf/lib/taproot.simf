/// Script hash of the Taproot output `OP_1 <taptweak(internal_key, tap_node)>`.
pub fn get_p2tr_script_hash(internal_key: Pubkey, tap_node: u256) -> u256 {
    let tweaked_key: u256 = jet::build_taptweak(internal_key, tap_node);

    // Segwit v1, length 32
    raw_hash::<(u16, u256)>((0x5120, tweaked_key))
}
