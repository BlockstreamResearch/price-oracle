use std::lib::utxo::getters::asset_id_with_amount::get_explicit_current_asset_id_with_amount;
use std::lib::utxo::asserts::asset_id_with_amount::assert_explicit_output_asset_id_with_amount;

/// The Storm Eye UTXO must be spent in its entirety: same asset, same amount.
pub fn assert_output_preserves_utxo(output_index: u32) {
    let (current_asset, current_amount): (u256, u64) = get_explicit_current_asset_id_with_amount();

    assert_explicit_output_asset_id_with_amount(output_index, current_asset, current_amount);
}
